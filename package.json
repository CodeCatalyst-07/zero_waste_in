{
  "name": "zerowastein",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zerowastein/web dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "eval:text": "node --experimental-strip-types eval/text-eval.ts",
    "eval:image": "node --experimental-strip-types eval/image-eval.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "check:budget": "node --experimental-strip-types scripts/check-bundle-budget.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@zerowastein/carbon": "workspace:*",
    "@zerowastein/contract": "workspace:*",
    "@zerowastein/rules": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.22.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
