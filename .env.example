# Provider execution order (default fallback sequence)
PROVIDER_ORDER=jarvis,gemini,gemma_gemini

# Jarvis Labs (OpenAI-compatible) configuration
JARVISLABS_API_KEY=
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
JARVISLABS_MODEL=gemma-4-31b-it
JARVIS_MAX_TOKENS=1024
JARVIS_EXTRA_BODY_JSON= # optional JSON string merged into body, e.g. {"reasoning_effort":"low"}
# JARVIS_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# Google Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY= # (leave blank; the developer fills it after checking AI Studio)
GEMINI_MODEL_ESCALATION= # (leave blank)
GEMMA_GEMINI_MODEL= # (leave blank)

# Circuit breaker, cross-check, and rate limiting
CROSS_CHECK_ENABLED=true
BREAKER_COOLDOWN_MS=60000
RATE_LIMIT_PER_MINUTE=20
MAX_TEXT_LENGTH=120

# System and request limits
REQUEST_TIMEOUT_MS=15000
MAX_UPLOAD_BYTES=1048576
